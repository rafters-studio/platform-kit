{
  "name": "@rafters/platform-auth",
  "version": "0.2.0",
  "description": "Auth for every Rafters brand: better-auth option objects, never a wrapper.",
  "homepage": "https://github.com/rafters-studio/platform-kit#readme",
  "bugs": {
    "url": "https://github.com/rafters-studio/platform-kit/issues"
  },
  "license": "MIT",
  "author": "Sean Silvius",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafters-studio/platform-kit.git",
    "directory": "packages/auth"
  },
  "bin": {
    "platform-auth-migrations": "./dist/migrations/install.mjs"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "type": "module",
  "exports": {
    "./shared": "./dist/shared/index.mjs",
    "./server": "./dist/server/index.mjs",
    "./client": "./dist/client/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@rafters/platform-contracts": "workspace:*",
    "uuidv7": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/api-key": "catalog:",
    "@better-auth/expo": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@rafters/ledger": "catalog:",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@better-auth/api-key": "catalog:peers",
    "@better-auth/expo": "catalog:peers",
    "@better-auth/passkey": "catalog:peers",
    "@rafters/ledger": "catalog:peers",
    "better-auth": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@better-auth/expo": {
      "optional": true
    },
    "@rafters/ledger": {
      "optional": true
    }
  }
}
